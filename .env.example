# FreeAgent OAuth app credentials — from https://dev.freeagent.com/apps
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=

# Leave blank, then run get_refresh_token.py — it fills this in for you
# automatically. Long-lived, so you shouldn't need to touch OAuth again
# after that.
FREEAGENT_REFRESH_TOKEN=

# Fill these in after running list_accounts.py
ACCOUNT_POLLUTED_ID=
ACCOUNT_CLEAN_ID=
